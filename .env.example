OLLAMA_HOST=http://localhost:11434

# Escritorio (RTX 5070 Ti, 16 GB):  llama3.1:8b   | visión: llama3.2-vision
# Notebook  (RTX 4050,      6 GB):  llama3.2:3b   | visión: gemma3:4b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=gemma3:4b

# Modelos de Hugging Face (opcional, estos son los valores por defecto)
